<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Evaluación Fitosanitaria de Vid</title>
<style>
:root{--e8:#065f46;--e7:#047857;--e1:#d1fae5;--e0:#ecfdf5;--g:#6b7280;--bd:#e5e7eb;--c0:#10b981;--c1:#facc15;--c2:#f97316;--c3:#dc2626}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;background:#f3f4f6;color:#1f2937;padding-bottom:20px;touch-action:manipulation}
header{background:var(--e8);color:#fff;position:sticky;top:0;z-index:10;box-shadow:0 2px 6px #0003}
.hd{max-width:720px;margin:auto;padding:10px 14px;display:flex;justify-content:space-between;align-items:center}
.hd h1{margin:0;font-size:1.1rem}.hd p{margin:0;font-size:.72rem;color:#a7f3d0}
.rs{background:#dc2626;color:#fff;border:0;border-radius:9px;padding:7px 12px;font-size:.75rem;font-weight:700}
.nv{max-width:720px;margin:auto;display:flex}.nv button{flex:1;background:none;border:0;color:#a7f3d0;padding:9px;font-weight:700;border-bottom:3px solid transparent}.nv button.on{color:#fff;border-color:#facc15}
main{max-width:720px;margin:auto;padding:12px}
.card{background:#fff;border:1px solid var(--bd);border-radius:16px;padding:14px;margin-bottom:12px;box-shadow:0 1px 2px #0001}
.gd{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
label{display:block;font-size:.72rem;font-weight:600;color:var(--g);margin:8px 0 3px}.gd label{margin-top:0}
input,select{width:100%;padding:9px 10px;border:1px solid #d1d5db;border-radius:9px;background:#f9fafb;font-size:.9rem}
.h{font-size:.72rem;font-weight:800;color:#4b5563;text-transform:uppercase;letter-spacing:.05em;margin:0 0 8px}
.gen{display:flex;gap:8px}.gen input{font-size:1.2rem;font-weight:800;text-align:center}
.btn{border:0;border-radius:12px;padding:12px 16px;font-weight:700;font-size:.95rem;background:var(--e7);color:#fff;cursor:pointer}
.btn.g{background:#e5e7eb;color:#374151}.btn.w{background:#16a34a}.btn.x{background:var(--c3)}.btn.s{background:#fff;color:var(--e7);border:2px solid var(--e7);padding:10px 8px;font-size:.85rem}
.qk{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:8px}.qk button{padding:9px;border-radius:10px;border:1px solid var(--bd);background:#f3f4f6;color:var(--e8);font-weight:700}
.pills{display:flex;gap:6px;overflow-x:auto;padding:4px 0 8px}.pills::-webkit-scrollbar,.sl::-webkit-scrollbar{display:none}
.pills button{flex:0 0 auto;min-width:40px;padding:7px 10px;border-radius:9px;border:2px solid transparent;background:#e5e7eb;color:#4b5563;font-weight:700;font-size:.8rem}
.pills button.cur{border-color:#111;box-shadow:0 0 0 2px #fff inset}
.sl{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;border-radius:16px;background:#fff;border:1px solid var(--bd);align-items:flex-start}
.sc{flex:0 0 100%;scroll-snap-align:start;padding:14px}
.sc .t{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--bd);padding-bottom:8px;margin-bottom:10px}
.pl{font-size:.72rem;background:#f3f4f6;color:#4b5563;padding:3px 10px;border-radius:99px;font-weight:700}
.go{width:100%;text-align:left;padding:11px;margin-bottom:8px;border-radius:12px;border:2px solid #e5e7eb;background:#f9fafb;font-weight:700;font-size:.9rem;display:flex;justify-content:space-between;align-items:center}
.go small{font-weight:400;color:#6b7280;display:block;font-size:.72rem}
.go.on{background:#d1fae5;border-color:var(--c0)}
.fh{border:2px solid #e5e7eb;border-radius:14px;padding:10px;margin-bottom:10px;background:#fcfcfd}
.fh.fp{border-left:6px solid #f97316}.fh.fe{border-left:6px solid #7c3aed}
.fr{display:flex;justify-content:space-between;align-items:center}
.rm{background:#fee2e2;color:#b91c1c;border:0;border-radius:8px;padding:5px 10px;font-weight:800}
.gr4{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.gb{padding:8px 2px;border-radius:10px;border:2px solid #e5e7eb;background:#f9fafb;font-weight:800;font-size:.95rem;line-height:1.1}
.gb small{display:block;font-weight:600;font-size:.62rem;color:#6b7280}
.gb.s0.on{background:#d1fae5;border-color:var(--c0)}.gb.s1.on{background:#fef9c3;border-color:var(--c1)}.gb.s2.on{background:#ffedd5;border-color:var(--c2)}.gb.s3.on{background:#fee2e2;border-color:var(--c3)}
.ad{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:4px}
.ph{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}
.cam{margin:0;display:block;text-align:center;border:2px dashed #9ca3af;border-radius:10px;padding:12px 4px;font-size:.8rem;font-weight:700;color:#4b5563;background:#f9fafb}
.th{position:relative;border-radius:10px;overflow:hidden;border:2px solid var(--e7);background:#e5e7eb;height:84px}
.th img{width:100%;height:100%;object-fit:cover;display:block}
.th span{position:absolute;top:4px;left:4px;background:var(--e7);color:#fff;font-size:.7rem;font-weight:800;border-radius:6px;padding:1px 7px}
.nav{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}
.k{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.k div{background:#f9fafb;border:1px solid var(--bd);border-radius:12px;padding:10px;text-align:center}.k b{display:block;font-size:1.35rem}.k span{font-size:.7rem;color:var(--g);font-weight:600}
.k3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.k3 div{background:#f9fafb;border:1px solid var(--bd);border-radius:10px;padding:6px;text-align:center}.k3 b{display:block;font-size:1.05rem}.k3 span{font-size:.65rem;color:var(--g);font-weight:600}
.og{border:1px solid var(--bd);border-radius:14px;padding:10px;margin-top:10px;background:#fff}
.or{display:flex;justify-content:space-between;align-items:center;gap:6px;margin-bottom:8px;font-size:.88rem}
.bd{color:#fff;font-size:.68rem;font-weight:800;padding:3px 8px;border-radius:99px;white-space:nowrap}
.dec{padding:12px;border-radius:12px;color:#fff;font-weight:800;margin-top:10px}.dec p{margin:3px 0 0;font-weight:400;font-size:.85rem}
.ex{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}
.tw{overflow-x:auto}table{border-collapse:collapse;width:100%;font-size:.76rem}th,td{padding:6px;border-bottom:1px solid var(--bd);white-space:nowrap;text-align:left}
.mu{color:var(--g);font-size:.75rem}.hide{display:none!important}
.hb{display:flex;align-items:center;gap:6px;margin:5px 0;font-size:.76rem}.hb>span:first-child{flex:0 0 42%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.hb i{display:block;height:10px;border-radius:5px;background:var(--c3)}.hb em{font-style:normal;color:var(--g);font-size:.7rem}
footer{text-align:center;font-size:.75rem;color:var(--g);padding:18px;border-top:1px solid var(--bd);margin-top:10px;background:#fff}footer b{color:var(--e7)}
#ov{position:fixed;inset:0;z-index:60;background:#000d;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:16px}#ov img{max-width:100%;max-height:75vh;border-radius:12px}
#ov2{position:fixed;inset:0;z-index:50;background:#0008;overflow-y:auto;padding:12px}#ov2>div{max-width:720px;margin:auto;background:#fff;border-radius:16px;padding:14px}
.rf{border:1px solid var(--bd);border-radius:10px;padding:8px;margin-top:8px;font-size:.8rem}.rf img{width:96px;height:72px;object-fit:cover;border-radius:8px;margin:4px 4px 0 0;border:1px solid #ccc}
#intro{position:fixed;inset:0;z-index:70;display:flex;align-items:center;justify-content:center;text-align:center;padding:24px;color:#fff;background:#0c2340}
.ibg{position:absolute;inset:0;background:linear-gradient(160deg,#0c2340,#065f46)}
.ic{position:relative;display:flex;flex-direction:column;align-items:center;gap:6px;max-width:380px;width:100%}
.ic h1{margin:14px 0 0;font-size:1.5rem}.ic p{margin:0;color:#e5d9a8}
.lg{width:180px;height:180px;border-radius:30px;border:2px solid #c9a227;box-shadow:0 10px 34px #000a;object-fit:cover}
.lgi:not([src]){display:none}
#intro .btn{width:100%;max-width:320px;margin-top:18px;background:#c9a227;color:#0c2340}
.ic .cr{font-size:.75rem;margin-top:10px;opacity:.85}
#auth{position:fixed;inset:0;z-index:40;background:linear-gradient(#0c2340,#065f46);overflow-y:auto;padding:18px}
.ac{max-width:380px;margin:20px auto;background:#fff;border-radius:18px;padding:18px;box-shadow:0 10px 30px #0006}
.ac h2{margin:8px 0 12px;font-size:1.1rem;text-align:center;color:#064e3b}
.lg2{display:block;width:96px;height:96px;border-radius:18px;margin:0 auto;border:2px solid #c9a227;object-fit:cover}
</style></head><body>

<div id="intro"><div class="ibg"></div><div class="ic"><img class="lg lgi" alt=""><h1>Evaluación Fitosanitaria de Vid</h1><p>Plagas y enfermedades · Campo</p>
<button class="btn" onclick="document.getElementById('intro').remove()">Ingresar a la aplicación</button><p class="cr">Creado por Andy Espino A.</p></div></div>

<header><div class="hd"><div><h1>🍇 Evaluación Fitosanitaria Vid</h1><p id="sub">Plagas &amp; Enfermedades • Campo</p></div><div style="display:flex;gap:6px"><button class="rs" onclick="reiniciar()">↻ Reiniciar</button><button class="rs" style="background:#374151" id="bsal" onclick="salir()">Salir</button></div></div>
<div class="nv"><button id="n1" class="on" onclick="tab(1)">Evaluación</button><button id="n2" onclick="tab(2)">Historial</button></div></header>

<main>
<div id="v1">
<div class="card"><p class="h">Datos de la evaluación</p><div class="gd">
<div><label>Fundo</label><input data-k="fundo" placeholder="Ej. Fundo Santa Rosa"></div>
<div><label>Lote</label><input data-k="lote" placeholder="Ej. Lote 04"></div>
<div><label>Cultivo</label><input data-k="cultivo"></div>
<div><label>Variedad</label><input data-k="variedad" list="vars" placeholder="Ej. Red Globe"></div>
<div><label>Fecha</label><input data-k="fecha" type="date"></div>
<div><label>Responsable</label><input data-k="resp" placeholder="Evaluador"></div>
<div><label>Estado fenológico</label><select data-k="fen" id="fen"></select></div>
<div><label>Hectáreas (Ha)</label><input data-k="ha" type="number" step="0.1" inputmode="decimal"></div></div>
<datalist id="vars"><option>Red Globe</option><option>Sweet Globe</option><option>Crimson Seedless</option><option>Thompson Seedless</option><option>Sweet Celebration</option><option>Allison</option><option>Autumn Crisp</option><option>Flame Seedless</option><option>Superior Seedless</option><option>Ivory</option></datalist></div>

<div class="card"><p class="h">1. ¿Cuántas muestras evaluarás?</p>
<div class="gen"><input id="nn" type="number" min="1" max="200" inputmode="numeric" placeholder="Ej. 25"><button class="btn" onclick="generar()">Generar</button></div>
<div class="qk"><button onclick="q(10)">10</button><button onclick="q(20)">20</button><button onclick="q(30)">30</button><button onclick="q(50)">50</button></div>
<p class="mu">Escribe cualquier número (1 a 200) o toca uno rápido. En cada muestra marca “limpia” o agrega las plagas y enfermedades encontradas.</p></div>

<div id="ev" class="hide">
<div style="display:flex;justify-content:space-between;padding:0 4px 4px"><b id="lp" class="mu" style="font-size:.8rem"></b><span class="mu">Desliza →</span></div>
<div class="pills" id="pills"></div><div class="sl" id="sl"></div>
<div class="nav"><button class="btn g" onclick="mv(-1)">◀ Anterior</button><button class="btn" onclick="mv(1)">Siguiente ▶</button></div>

<div class="card" style="margin-top:12px"><p class="h">Resultado por plaga y enfermedad</p><div id="res"></div></div>
<div class="ex"><button class="btn" onclick="guardar()">💾 Guardar</button><button class="btn w" onclick="wsp()">📲 WhatsApp</button></div>
<details class="card" style="margin-top:12px"><summary><b>Umbrales de decisión</b></summary>
<p class="mu">Valores referenciales de trabajo, no oficiales; ajústalos con tu asesor. Incidencia = % de muestras con grado ≥1. Índice = Σ(grado)/(3×N)×100. Las plagas marcadas como cuarentenarias (chanchito, mosca de la fruta) pasan a ALERTA con cualquier presencia.</p>
<div class="gd"><div><label>Incidencia alerta %</label><input data-c="ia" type="number"></div><div><label>Incidencia crítica %</label><input data-c="ib" type="number"></div><div><label>Índice alerta</label><input data-c="xa" type="number"></div><div><label>Índice crítico</label><input data-c="xb" type="number"></div></div></details>
</div></div>

<div id="v2" class="hide"><div class="card"><p class="h">Filtros</p><div class="gd">
<div><label>Lote</label><select id="f_lote" onchange="hist()"></select></div>
<div><label>Vista</label><select id="f_vista" onchange="hist()"><option value="d">Por día</option><option value="l">Por lote</option></select></div>
<div><label>Desde</label><input type="date" id="f_d1" onchange="hist()"></div>
<div><label>Hasta</label><input type="date" id="f_d2" onchange="hist()"></div>
<div id="f_evw" class="hide"><label>Evaluador</label><select id="f_ev" onchange="hist()"></select></div></div>
<div class="ex"><button class="btn" onclick="sync(true)">☁ Sincronizar</button><button class="btn s" onclick="cargaNube()">⟳ Actualizar nube</button></div>
<p class="mu" id="syncinfo"></p>
<a id="shl" class="btn s hide" style="display:block;text-align:center;text-decoration:none;margin-top:8px" target="_blank" rel="noopener">📊 Abrir Google Sheet (base de datos)</a></div>
<div class="card" id="dash"></div>
<div class="card"><div class="ex" style="margin:0 0 10px"><button class="btn" onclick="excel()">⬇ Excel</button><button class="btn x" onclick="borrar()">Borrar del equipo</button></div><div class="tw" id="tb"></div></div></div>
</main>
<footer><p style="margin:0">Sistema de Evaluación Fitosanitaria de Vid</p><b>Creado por Andy Espino A.</b></footer>

<div id="auth" class="hide"><div class="ac"><img class="lg2 lgi" alt=""><h2>Evaluación Fitosanitaria de Vid</h2>
<label>Usuario</label><input id="a_usr" autocapitalize="none" autocomplete="username">
<label>Contraseña</label><input id="a_pw" type="password" autocomplete="current-password">
<p id="a_msg" class="mu" style="color:#b91c1c;min-height:1em"></p>
<button class="btn" id="a_go" style="width:100%;margin-top:6px" onclick="authGo()">Ingresar</button>
<p class="mu" style="text-align:center;margin:12px 0 0">Creado por Andy Espino A.</p></div></div>
<div id="ov" class="hide"></div><div id="ov2" class="hide"></div>

<script>
const $=i=>document.getElementById(i),COL=['#10b981','#facc15','#f97316','#dc2626'],GL=['Limpio','Leve','Moderado','Grave'];
const esc=s=>String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,6);
const BASE={p:[['Chanchito blanco (Planococcus)',1],['Trips',0],['Arañita roja (Tetranychus)',0],['Ácaro del enrollamiento (erinosis)',0],['Brevipalpus (falsa arañita)',0],['Spodoptera (gusano cogollero)',0],['Heliothis / Helicoverpa',0],['Gusano cachudo (Pholus)',0],['Cigarrita (Empoasca)',0],['Mosca de la fruta (Ceratitis)',1],['Queresa (Oregmopyga)',0],['Barrenador de tallo',0],['Hormigas',0]],
e:[['Oídio',0],['Mildiu',0],['Botrytis (pudrición gris)',0],['Pudrición ácida',0],['Antracnosis',0],['Lasiodiplodia (muerte regresiva)',0],['Phomopsis (excoriosis)',0],['Alternaria',0],['Virosis (enrollamiento)',0],['Tumor de la vid (Agrobacterium)',0]]};
const PA=['Tallo','Hojas','Brotes','Fruto','Raquis'];
const FEN=['','Reposo / poda','Brotación','Crecimiento de brote','Floración','Cuaja','Crecimiento de baya','Envero','Maduración / cosecha','Post cosecha'];
const CD={ia:10,ib:30,xa:10,xb:25};
const NV=['🟢 CONFORME','🟠 ALERTA','🔴 CRÍTICO'],DC=['#059669','#ea580c','#dc2626'];
const TX=['Dentro de los umbrales de trabajo. Mantener el monitoreo.','Hay incidencia sobre el nivel de alerta o presencia de plaga cuarentenaria o grado grave: marcar focos y reevaluar en 5–7 días.','Superó el umbral crítico: priorizar el control y revisar con el asesor técnico.'];
const ld=(k,d)=>{try{return JSON.parse(localStorage.getItem(k))||d}catch(e){return d}};
const sv=(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v))}catch(e){alert('Memoria llena: exporta a Excel y borra registros antiguos.')}};
let S=Object.assign({fundo:'',lote:'',cultivo:'Uva',variedad:'',fecha:new Date().toISOString().slice(0,10),resp:'',fen:'',ha:'',m:[]},ld('vid_s',{}));
let C=Object.assign({},CD,ld('vid_c',{})),R=ld('vid_r',[]),CU=Object.assign({p:[],e:[]},ld('vid_u',{})),FL='';
const save=()=>sv('vid_s',S);
const names=t=>BASE[t].map(x=>x[0]).concat(CU[t]);
const isQ=n=>BASE.p.some(x=>x[0]===n&&x[1]);
/* fotos en IndexedDB */
const DB=new Promise(res=>{try{const r=indexedDB.open('vid_fotos',1);r.onupgradeneeded=()=>r.result.createObjectStore('p');r.onsuccess=()=>res(r.result);r.onerror=()=>res(null)}catch(e){res(null)}});
async function pPut(k,v){const d=await DB;if(!d)return;return new Promise(r=>{const t=d.transaction('p','readwrite');t.objectStore('p').put(v,k);t.oncomplete=r;t.onerror=r})}
async function pGet(k){if(!k)return null;if(String(k).startsWith('d:'))return 'https://drive.google.com/thumbnail?id='+String(k).slice(2)+'&sz=w900';const d=await DB;if(!d)return null;return new Promise(r=>{const q=d.transaction('p').objectStore('p').get(k);q.onsuccess=()=>r(q.result||null);q.onerror=()=>r(null)})}
async function pDel(k){if(!k||String(k).startsWith('d:'))return;const d=await DB;if(!d)return;return new Promise(r=>{const t=d.transaction('p','readwrite');t.objectStore('p').delete(k);t.oncomplete=r;t.onerror=r})}
function hydrate(root){root.querySelectorAll('img[data-ph]').forEach(async im=>{const v=await pGet(im.dataset.ph);if(v)im.src=v})}
function comp(file){return new Promise(res=>{const im=new Image(),u=URL.createObjectURL(file);im.onload=()=>{const s=Math.min(1,900/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=Math.round(im.width*s);c.height=Math.round(im.height*s);c.getContext('2d').drawImage(im,0,0,c.width,c.height);URL.revokeObjectURL(u);res(c.toDataURL('image/jpeg',.7))};im.onerror=()=>res(null);im.src=u})}
const delPhotos=ms=>ms.forEach(m=>m.h.forEach(f=>{pDel(f.fa);pDel(f.fb)}));

function tab(t){$('v1').classList.toggle('hide',t!==1);$('v2').classList.toggle('hide',t!==2);$('n1').className=t===1?'on':'';$('n2').className=t===2?'on':'';if(t===2)hist();window.scrollTo(0,0)}
function q(n){$('nn').value=n}
const evalOK=m=>m.c||(m.h.length>0&&m.h.every(f=>f.n&&f.g!==null));
function generar(){const n=Math.floor(+$('nn').value);if(!(n>=1&&n<=200)){alert('Escribe un número entre 1 y 200');return}
if(S.m.some(evalOK)&&!confirm('Ya hay muestras calificadas. ¿Generar de nuevo y borrarlas?'))return;delPhotos(S.m);S.m=Array.from({length:n},()=>({c:0,h:[]}));save();draw()}
function draw(){if(!S.m.length){$('ev').classList.add('hide');return}$('ev').classList.remove('hide');
$('sl').innerHTML=S.m.map((_,i)=>`<div class="sc" id="c${i}">${card(i)}</div>`).join('');hydrate($('sl'));pills();res();setTimeout(()=>go(0),0)}
function card(i){const m=S.m[i];return `<div class="t"><b>MUESTRA #${i+1}</b><span class="pl">${i+1} / ${S.m.length}</span></div>
<button class="go ${m.c?'on':''}" onclick="limpia(${i})"><span>✔ Muestra limpia<small>Sin plagas ni enfermedades</small></span><span>${m.c?'✔':''}</span></button>
${m.h.map((f,j)=>fh(i,j,f)).join('')}
<div class="ad"><button class="btn s" onclick="add(${i},'p')">🐛 + Plaga</button><button class="btn s" onclick="add(${i},'e')">🍂 + Enfermedad</button></div>`}
function fh(i,j,f){const T=f.t==='p',nm=names(f.t);if(f.n&&!nm.includes(f.n))nm.push(f.n);
